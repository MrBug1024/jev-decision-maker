# Copy this file to .env before starting the service.

# Model bundle. A larger compatible JEV model can be selected here.
OPEN_JEV_MODEL_ID=com-kotobalabs/open-jev-deberta-v3-large
OPEN_JEV_MODEL_NAME=open-jev-deberta-v3-large
# typed_decisions is the current text JEV adapter. A future Omni adapter can
# use jev_omni after its model-specific loader is implemented.
OPEN_JEV_MODEL_KIND=typed_decisions
OPEN_JEV_MODEL_INPUTS=text
OPEN_JEV_MODEL_REVISION=

# HTTP and persistence.
OPEN_JEV_HOST=0.0.0.0
OPEN_JEV_PORT=8019
OPEN_JEV_PUBLIC_URL=http://127.0.0.1:8019
OPEN_JEV_DB_PATH=./jev_gateway.db
OPEN_JEV_COOKIE_SECURE=0
OPEN_JEV_CORS_ORIGINS=http://127.0.0.1:8019

# Runtime placement: auto selects CPU, one GPU, or multi-GPU sharding.
OPEN_JEV_MODEL_DEVICE=auto
OPEN_JEV_DEVICE_MAP=auto
OPEN_JEV_MODEL_DTYPE=auto
OPEN_JEV_GPU_MEMORY_RESERVE_GIB=2
OPEN_JEV_CPU_MEMORY_LIMIT_GIB=
OPEN_JEV_MODEL_CACHE=./.cache/huggingface
OPEN_JEV_OFFLOAD_DIR=./model_offload
OPEN_JEV_MAX_CONCURRENT_INFERENCE=1
OPEN_JEV_MAX_UPLOAD_MB=50
OPEN_JEV_TRUST_REMOTE_CODE=0
OPEN_JEV_SKIP_MODEL_LOAD=0

# Logging and sessions.
OPEN_JEV_LOG_LEVEL=info
OPEN_JEV_SESSION_TTL=2592000
OPEN_JEV_PASSWORD_ITERATIONS=310000

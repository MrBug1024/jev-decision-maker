# Production mode: use the official merged BF16 checkpoint. Direct INT8/INT4
# quantization of the Jev decision backbone is not accuracy-safe for this model.
CUDA_VISIBLE_DEVICES=0
JEV_OMNI_MODEL_PATH=../models/raw/jev-omni
JEV_OMNI_MODEL_NAME=jev-omni-bf16
JEV_OMNI_QUANTIZATION=bf16
JEV_OMNI_MODEL_INPUTS=text,image,audio,video

# HTTP and MCP.
JEV_OMNI_HOST=0.0.0.0
JEV_OMNI_PORT=8020
JEV_OMNI_PUBLIC_URL=http://127.0.0.1:8020
JEV_OMNI_DB_PATH=../data/jev_gateway.db
JEV_OMNI_COOKIE_SECURE=0
JEV_OMNI_CORS_ORIGINS=http://127.0.0.1:8020

# Placement. Keep one process/one worker for a large model.
JEV_OMNI_MODEL_DEVICE=auto
JEV_OMNI_DEVICE_MAP=auto
JEV_OMNI_MODEL_DTYPE=bf16
JEV_OMNI_GPU_MEMORY_RESERVE_GIB=2
JEV_OMNI_CPU_MEMORY_LIMIT_GIB=64
JEV_OMNI_MODEL_CACHE=
JEV_OMNI_OFFLOAD_DIR=./model_offload
JEV_OMNI_MAX_CONCURRENT_INFERENCE=1
JEV_OMNI_MAX_UPLOAD_MB=50
JEV_OMNI_TRUST_REMOTE_CODE=1
JEV_OMNI_SKIP_MODEL_LOAD=0

# Logging and sessions.
JEV_OMNI_LOG_LEVEL=info
JEV_OMNI_SESSION_TTL=2592000
JEV_OMNI_PASSWORD_ITERATIONS=310000
